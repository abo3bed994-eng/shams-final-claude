{
  "expo": {
    "name": "Shams Tex",
    "slug": "shamstex",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "shamstex",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon-new.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.shamstex.app",
      "icon": "./assets/images/app-icon.png",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.shamstex.app",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon.png",
        "backgroundColor": "#EDE3CC"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.VIBRATE"
      ],
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://shamstex.app"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "يحتاج التطبيق للوصول إلى صورك لرفع صور المنتجات",
          "cameraPermission": "يحتاج التطبيق للوصول إلى الكاميرا لالتقاط صور المنتجات"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#C9A84C"
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Stealth",
            "ios": "./assets/images/icon-new.png",
            "android": {
              "foregroundImage": "./assets/images/adaptive-icon.png",
              "backgroundColor": "#0A0A0A"
            }
          }
        ]
      ]
    ],
    "runtimeVersion": "1.1.0",
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "0fabe669-f585-4876-b076-774ecd01c24d"
      }
    },
    "owner": "shams_tex"
  }
}